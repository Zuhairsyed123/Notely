# Notely Configuration

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Storage Directories (Relative to project root or absolute paths)
NOTELY_DATA_DIR=data
NOTELY_CHROMA_DIR=data/chroma

# RAG & Embeddings
# Uses local sentence-transformers model (downloads automatically on first use)
NOTELY_EMBEDDING_MODEL=all-MiniLM-L6-v2
NOTELY_DEFAULT_CHUNK_SIZE=500
NOTELY_DEFAULT_CHUNK_OVERLAP=100
NOTELY_DEFAULT_TOP_K=4

# Generation Provider: "mock", "openai", "gemini", or "groq"
# "mock" runs locally without any paid API keys (clearly labeled in UI)
NOTELY_LLM_PROVIDER=mock

# External Provider API Keys (Leave blank if using mock provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
